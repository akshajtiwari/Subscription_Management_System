{
  "name": "brightloop-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "format": "prettier --ignore-path ../.prettierignore --write . ../compose.yaml ../.prettierrc.json",
    "format:check": "prettier --ignore-path ../.prettierignore --check . ../compose.yaml ../.prettierrc.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "prettier": "3.9.9",
    "@playwright/test": "1.56.1"
  }
}
